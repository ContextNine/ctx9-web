{
  "name": "@ctx9/web-auth",
  "version": "8.0.1",
  "description": "Shared CTX9 confidential OIDC BFF protocol",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "default": "./dist/adapters/express.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./tanstack-start": {
      "types": "./dist/adapters/tanstack-start.d.ts",
      "default": "./dist/adapters/tanstack-start.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://gitlab.com/api/v4/projects/85438020/packages/npm/"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "22.16.0"
  },
  "dependencies": {
    "jose": "6.2.8",
    "zod": "4.4.3"
  }
}
