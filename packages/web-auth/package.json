{
  "name": "@ctx9/web-auth",
  "version": "9.3.1",
  "description": "Shared CTX9 confidential OIDC BFF protocol",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContextNine/ctx9-web.git",
    "directory": "packages/web-auth"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "default": "./dist/adapters/express.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./tanstack-start": {
      "types": "./dist/adapters/tanstack-start.d.ts",
      "default": "./dist/adapters/tanstack-start.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.16.0 || ^24.21.0 || ^26.11.1"
  },
  "dependencies": {
    "jose": "6.2.8",
    "zod": "4.4.3"
  }
}
