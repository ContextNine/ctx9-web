{
  "name": "@ctx9/ui",
  "version": "8.0.1",
  "description": "Shared Impression and CTX9 internal application UI",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./dev": {
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.js"
    },
    "./style-policy": {
      "types": "./dist/style-policy.d.ts",
      "default": "./dist/style-policy.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./icon.svg": "./dist/assets/icon.svg"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://gitlab.com/api/v4/projects/85438020/packages/npm/"
  },
  "bin": {
    "ctx9-ui-dev": "./dist/dev-cli.js",
    "ctx9-ui-style-check": "./dist/style-policy-cli.js"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json && tailwindcss -c tailwind.config.cjs -i src/styles.css -o dist/styles.css --postcss ../../postcss.config.js --no-autoprefixer --minify && mkdir -p dist/assets dist/fonts && cp src/assets/icon.svg dist/assets/icon.svg && cp -R src/fonts/. dist/fonts/",
    "clean": "rm -rf dist",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "typescript": "5.9.3",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.23.24",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6",
    "lucide-react": "0.546.0",
    "react-day-picker": "9.11.1",
    "react-colorful": "5.6.1",
    "react-hook-form": "7.66.1",
    "react-resizable-panels": "3.0.6",
    "radix-ui": "1.4.3",
    "recharts": "3.8.1",
    "sonner": "1.7.4",
    "tailwind-merge": "3.4.0"
  },
  "engines": {
    "node": "22.16.0"
  },
  "peerDependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "jsdom": "30.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vitest-axe": "0.1.0"
  }
}
