{
  "name": "@ctx9/ui",
  "version": "1.0.0",
  "description": "Dark-only CTX9 internal product design system",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://gitlab.com/api/v4/projects/85438020/packages/npm/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tailwindcss -i src/styles.css -o dist/styles.css --minify && cp -R src/fonts dist/fonts",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
