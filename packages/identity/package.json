{
  "name": "@ctx9/identity",
  "version": "9.0.1",
  "description": "Passkey and confidential OIDC identity authority with application-owned persistence",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContextNine/ctx9-web.git",
    "directory": "packages/identity"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.16.0 || ^24.21.0 || ^26.11.1"
  },
  "dependencies": {
    "@better-auth/core": "1.7.0-beta.10",
    "@better-auth/oauth-provider": "1.7.0-beta.10",
    "@better-auth/passkey": "1.7.0-beta.10",
    "@better-fetch/fetch": "1.3.1",
    "better-auth": "1.7.0-beta.10",
    "better-call": "1.3.7",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.21.0"
  }
}
