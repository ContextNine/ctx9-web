{
  "name": "@ctx9/web-workspace",
  "version": "9.4.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.16.0 || ^24.21.0 || ^26.11.1",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "clean": "pnpm --recursive clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "archives:check": "tsx scripts/check-package-archives.ts",
    "install:check": "tsx scripts/check-isolated-install.ts",
    "packages:check": "tsx scripts/check-packages.ts",
    "provenance:check": "tsx scripts/check-provenance.ts",
    "release:build": "tsx scripts/build-package-release.ts",
    "styles:check": "tsx scripts/check-styles.ts",
    "test": "vitest run",
    "typecheck": "pnpm --recursive typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm styles:check && pnpm packages:check && pnpm provenance:check && pnpm archives:check && pnpm install:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.1",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.1",
    "npm": "11.20.0",
    "prettier": "3.6.2",
    "postcss": "8.5.18",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
